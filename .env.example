# Backup Console — server environment. Copy to .env.local and fill in.
# Nothing here is ever sent to the browser or passed to backup.js.

# ── Supabase (Project Settings › API) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key — used only to verify sign-in passwords
SUPABASE_ANON_KEY=
# service_role / secret key — full database access; server only, never commit
SUPABASE_SERVICE_ROLE_KEY=

# ── Vault ───────────────────────────────────────────────────────────────────
# 32 random bytes (base64). Lets backup runs decrypt credentials without the
# vault password — so whoever can read this key AND the database can read every
# credential. Keep it OUT of this file, in a file only the console's account can
# read, and keep a backup copy somewhere safe. If it is lost, a super admin must
# unlock the vault once with the vault password to re-seal it for a new key.
#
#   PowerShell, one time:
#     $d = "$env:USERPROFILE\.backup-console"; mkdir $d -Force | Out-Null
#     node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))" > "$d\vault-server.key"
#     icacls "$d\vault-server.key" /inheritance:r /grant:r "$($env:USERNAME):(R,W)"
VAULT_SERVER_KEY_FILE=
# (VAULT_SERVER_KEY=<base64> inline is still accepted, but not recommended.)

# ── Network ─────────────────────────────────────────────────────────────────
# The console answers only to 127.0.0.1 / localhost / [::1]. To serve it under
# another name (behind a TLS reverse proxy), list it here, e.g. backups.example.com
# Those names are HTTPS-only: the proxy must send X-Forwarded-Proto: https, or
# the console redirects GETs to https:// and refuses everything else.
# CONSOLE_ALLOWED_HOSTS=

# ── Optional ────────────────────────────────────────────────────────────────
# Where managed tools, plugin cache and default backups live (default ./data)
# CONSOLE_DATA_DIR=

# Optional: Redis for the shared cache of Cloudflare reads (zone explorer, zone lists, activity lookups).
# Without it the cache is kept in memory. Use rediss:// with a password when Redis is not on this machine.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=backup-console
