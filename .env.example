# Backup Console — server environment. Copy to .env.local and fill in.
# Nothing here is ever sent to the browser or passed to backup.js.

# ── Supabase (Project Settings › API) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# anon / publishable key — used only to verify sign-in passwords
SUPABASE_ANON_KEY=
# service_role / secret key — full database access; server only, never commit
SUPABASE_SERVICE_ROLE_KEY=

# ── Vault ───────────────────────────────────────────────────────────────────
# Nothing to set. The vault server key (lets backups decrypt credentials without
# the vault password) is kept in Supabase, table vault_keys, and created on first
# use. Run supabase/migrations/0003_vault_server_key.sql once.
# Optional override: VAULT_SERVER_KEY=<32 random bytes, base64>
# VAULT_SERVER_KEY_FILE is no longer used.

# ── Network ─────────────────────────────────────────────────────────────────
# The console answers to any host name by default. To restrict it, list the
# names it may be reached under (loopback always works), e.g. backups.example.com
# Names other than 127.0.0.1 / localhost / [::1] are HTTPS-only: the proxy must
# send X-Forwarded-Proto: https, or the console redirects GETs to https:// and
# refuses everything else.
# CONSOLE_ALLOWED_HOSTS=
#
# Behind Cloudflare: a long random value that a Cloudflare Transform Rule sends in the
# x-console-origin-auth header (CONSOLE_ORIGIN_HEADER renames it). Requests without it get 403,
# so nobody can skip the WAF by calling Vercel directly. See CLOUDFLARE.md.
# To rotate it, set "new,old" (both accepted) until Cloudflare sends the new one (OPERATIONS.md).
# CONSOLE_ORIGIN_SECRET=
# CONSOLE_ORIGIN_HEADER=
# The header with the real visitor address, for rate limits (cf-connecting-ip behind Cloudflare).
# CONSOLE_CLIENT_IP_HEADER=
# How long an API call waits for the worker (ms). Keep it under Cloudflare's 100 s limit: 90000.
# CONSOLE_RELAY_TIMEOUT_MS=
# Traffic analytics: GraphQL queries per 5 minutes per Cloudflare token (Cloudflare allows about 300). Default 240.
# TRAFFIC_GQL_BUDGET=

# ── Vercel + worker ─────────────────────────────────────────────────────────
# all    — this server does everything (default, except on Vercel).
# web    — UI and sign-in only (default on Vercel): jobs and Cloudflare calls go to the worker.
# worker — set by `npm run worker`: runs the jobs the web side queues in Supabase.
# CONSOLE_ROLE=
#
# On Vercel: start the worker on GitHub Actions when someone needs it (README, Worker).
# WORKER_GITHUB_TOKEN=     fine-grained token for the repository, Actions: Read and write
# WORKER_GITHUB_REPO=      owner/name
# WORKER_GITHUB_REF=main

# ── Optional ────────────────────────────────────────────────────────────────
# CAPTCHA (Cloudflare Turnstile) on sign-in and first-run setup. On only when both are set.
# Cloudflare dashboard → Turnstile → Add widget, hostname = the console's hostname.
# For local testing, Cloudflare's always-pass test keys: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Where managed tools, plugin cache and default backups live (default ./data)
# CONSOLE_DATA_DIR=

# Optional: Redis for the shared cache of Cloudflare reads (zone explorer, zone lists, activity lookups).
# Without it the cache is kept in memory. Use rediss:// with a password when Redis is not on this machine.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=backup-console
